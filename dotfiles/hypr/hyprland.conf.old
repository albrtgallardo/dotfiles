#prefered para que elija la resolucion recomendada, y el numero es la escala
monitor = ,preferred,auto,1.0

# Layout por defecto (puedes poner 'us' o 'es' según prefieras)
input {
    kb_layout = us,es
    kb_options = grp:win_space_toggle
    sensitivity = 0.0
    accel_profile = flat
}

#wallpaper {
#    path = Images/wallpapers/my-neighbor-totoro-sunflowers.png
#}

#para evitar el flash del otro fondo de pantalla
#disable_hyprland_logo = true

#definir los workspaces
#workspace = 1

# --- tecla de super ---
$mod = SUPER

# --- terminal ---
$term = kitty

# --- moverse entre workspaces ---
bind = $mod, 1, workspace, 1
bind = $mod, 2, workspace, 2
bind = $mod, 3, workspace, 3
bind = $mod, 4, workspace, 4
bind = $mod, 5, workspace, 5
bind = $mod, 6, workspace, 6
bind = $mod, 7, workspace, 7
bind = $mod, 8, workspace, 8
bind = $mod, 9, workspace, 9
bind = $mod, 0, workspace, 10


# --- mover ventanas entre workspaces ---
bind = $mod+shift, 1, movetoworkspace, 1
bind = $mod+shift, 2, movetoworkspace, 2
bind = $mod+shift, 3, movetoworkspace, 3
bind = $mod+shift, 4, movetoworkspace, 4
bind = $mod+shift, 5, movetoworkspace, 5
bind = $mod+shift, 6, movetoworkspace, 6
bind = $mod+shift, 7, movetoworkspace, 7
bind = $mod+shift, 8, movetoworkspace, 8
bind = $mod+shift, 9, movetoworkspace, 9
bind = $mod+shift, 0, movetoworkspace, 10


binds {
    drag_threshold = 10  # Fire a drag event only after dragging for more than 10px
}

#bindm = ALT, mouse:272, movewindow      # ALT + LMB: Move a window by dragging more than 10px.
#bindc = ALT, mouse:272, togglefloating  # ALT + LMB: Floats a window by clicking

#  --- atajos de teclado ---
bind = $mod, D, exec, rofi -show drun
bind = $mod+shift, S, exec, flameshot gui 
bind = $mod, RETURN, exec, $term
bind = $mod, W, killactive
bind = $mod, F, fullscreen, 0
bind = $mod, G, togglefloating
bind = $mod+shift, L, exec, hyprlock

bind = alt, up, exec, pactl set-sink-volume @DEFAULT_SINK@ +5%
bind = alt, down, exec, pactl set-sink-volume @DEFAULT_SINK@ -5%
bind = alt, M, exec, pactl set-sink-mute @DEFAULT_SINK@ toggle
# pactl set-sink-volume @DEFAULT_SINK@ 100%


# Alt + n -> ñ
bind = ALT, N, exec, wtype "ñ"

# Alt + ' -> ´
bind = ALT, APOS, exec, wtype "´"

# Alt + - -> ~
bind = ALT, MINUS, exec, wtype "~"


#estos programas se inician automaticamente al iniciar la sesion y solo una vez

exec-once = hyprpaper
exec-once = waybar
exec-once = xwaylandvideobridge

# --- Estética de ventanas ---
general {
    gaps_in = 3                      # espacio entre ventanas
    gaps_out = 5                     # espacio entre ventanas y borde de pantalla
    border_size = 3                  # grosor de borde
    col.active_border = 0xff0e6879   # color borde ventana activa
    col.inactive_border = 0xffb57213 # color borde ventana inactiva
}

decoration {
    rounding = 10                 # bordes redondeados en píxeles
    active_opacity = 1.0
    inactive_opacity = 0.95

    blur {
        enabled = false
        vibrancy = 0.8
        contrast = 0.6
        size = 8
        passes = 2
        ignore_opacity = false
    }

    shadow{
        enabled = false
        sharp = false
    }
}


# --- Navegación entre ventanas con flechas ---
bind = $mod, left, movefocus, l
bind = $mod, right, movefocus, r
bind = $mod, up, movefocus, u
bind = $mod, down, movefocus, d

# --- Mover ventanas con flechas ---
bind = $mod+shift, left, movewindow, l
bind = $mod+shift, right, movewindow, r
bind = $mod+shift, up, movewindow, u
bind = $mod+shift, down, movewindow, d

# --- Para compartir pantalla ---
#windowrule = opacity 0.0 override, class:^(xwaylandvideobridge)$
#windowrule = noanim, class:^(xwaylandvideobridge)$
#windowrule = noinitialfocus, class:^(xwaylandvideobridge)$
#windowrule = maxsize 1 1, class:^(xwaylandvideobridge)$
#windowrule = noblur, class:^(xwaylandvideobridge)$
#windowrule = nofocus, class:^(xwaylandvideobridge)$
